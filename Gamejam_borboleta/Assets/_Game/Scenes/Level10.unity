      propertyPath: levelTitle
      value: "Cap\xEDtulo 10 \u2014 O Devorador do Tempo"
      objectReference: {fileID: 0}
    - target: {fileID: 3166981526944731491, guid: 93348a8f9ab02d445be93e39f718bd08, type: 3}
      propertyPath: levelNumber
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 3166981526944731491, guid: 93348a8f9ab02d445be93e39f718bd08, type: 3}
      propertyPath: completeText
      value: "O Cron\xF3fago caiu. O \xFAltimo fragmento volta ao seu lugar: o rel\xF3gio
