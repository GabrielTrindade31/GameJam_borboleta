--- !u!114 &1652771336
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1652771334}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.3, g: 0.18, b: 0.08, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: de60a504ace64ab4993a9b96b9e6aefb, type: 3}
    m_FontSize: 28
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "Eco n\xE3o \xE9 deste tempo. Ele vivia no fluxo dos dias, guiado pelo
    seu Rel\xF3gio,\nat\xE9 que o Cron\xF3fago, uma criatura que devora esta\xE7\xF5es,
    estilha\xE7ou o rel\xF3gio em dez fragmentos.\n\nSem ele, Eco ficou preso neste
    vale, num tempo que n\xE3o \xE9 o seu.\nPara voltar para casa, precisa reunir
    os fragmentos espalhados pelos dias e esta\xE7\xF5es.\n\nMas cuidado: aqui, cada
    pequeno gesto ecoa no futuro.\nUma borboleta que bate as asas hoje pode fechar
    ou abrir o caminho de volta."
