      objectReference: {fileID: 0}
    - target: {fileID: 3166981526944731491, guid: 93348a8f9ab02d445be93e39f718bd08, type: 3}
      propertyPath: introText
      value: "Primavera. Eco desperta preso num tempo que n\xE3o \xE9 o seu. Um fragmento
        do seu rel\xF3gio brilha l\xE1 no alto.\nQ e E fazem os dias passarem. Itens
        que voc\xEA pega viajam no tempo com voc\xEA."
      objectReference: {fileID: 0}
    - target: {fileID: 3166981526944731491, guid: 93348a8f9ab02d445be93e39f718bd08, type: 3}
      propertyPath: nextScene
      value: Level02
      objectReference: {fileID: 0}
    - target: {fileID: 3166981526944731491, guid: 93348a8f9ab02d445be93e39f718bd08, type: 3}
      propertyPath: levelTitle
      value: "Cap\xEDtulo 1 \u2014 O Primeiro Passo"
      objectReference: {fileID: 0}
    - target: {fileID: 3166981526944731491, guid: 93348a8f9ab02d445be93e39f718bd08, type: 3}
      propertyPath: completeText
      value: "Uma gota d'\xE1gua virou uma \xE1rvore em poucas semanas... e abriu
        o caminho at\xE9 o primeiro fragmento."
      objectReference: {fileID: 0}
